##################################################################################################
# Agent Default Entries - Top Level
#

agent:
  format: "agents-yapyon-v0.6.5"
  name: "builtin_agent"           # The agent's name
  desc: y"{name}"                 # Short Description (defaults to name)

  # Slots; these **must be filled** before being resolved.
  persona<>: {}                   # Persona slot, e.g. persona<persona.kimi> <REQUIRED>
  harness<>: {}                   # Harness slot, e.g. harness<harness.claude> <REQUIRED>
  secret<>: {}                    # Backend secret store (tokens, passwords) <REQUIRED>
