##################################################################################################
# Codex-CLI Harness Settings
#
# This is the harness that shows why negotiation beats a single declared dialect -- codex prefers
# Responses but works over Chat, so the winning protocol depends on the persona it is bound to,
# and `wire_api` names whichever it got.

harness<base.harness>:
  name: "codex"
  desc: "Codex CLI"
  path_var: "CODEX_HOME"
  supported_dialects: ["responses", "chat"]    # ordered by preference
  config_file: y"{path}/config.toml"

  config_store:
    model: (persona.mind.model_active)
    model_provider: (persona.name)

    # Nested maps become TOML tables, so this renders as [model_providers.codex].
    model_providers:
      y"{persona.name}":
        name: y"{persona.desc}"
        wire_api: y"{protocol}"
        base_url: y"{persona.mind.dialects[protocol].api_uri}"
        env_key: y"{auth_var}"

    models: {
      model_id: {provider: (persona.name), remote_model_id: (model_id)}
      for model_id in persona.mind.model_list
    }

  content: y"{config_store.__as_toml__()}"


# For later: http_headers = { "X-Account-Id" = "your-account-id", "User-Agent" = "Codex" }
