##################################################################################################
# Claude-Code Harness Settings
#
# Claude Code speaks exactly one dialect, so the negotiation is trivial -- but the shape stays
# uniform with codex and goose. The /v1/messages path and the anthropic-version header this file
# used to spell out by hand *were* the dialect; they live in dialect.anthropic.yaml now.

harness<base.harness>:
  name: "claude"
  desc: "Claude Code"
  supported_dialects: ["anthropic"]
  protocol: [dialect for dialect in supported_dialects if persona.mind.dialects.__get__(dialect) is not None][0]
  auth_var: "ANTHROPIC_AUTH_TOKEN"
  path_var: "CLAUDE_CONFIG_DIR"
  config_file: y"{path}/settings.json"
  config_store:
    model: (persona.mind.model_active)
    env:
      ANTHROPIC_AUTH_TOKEN: "no-token-required"
      ANTHROPIC_BASE_URL: y"{persona.mind.dialects[protocol].api_uri}"
      ANTHROPIC_MODEL: (persona.mind.model_active)
      ANTHROPIC_DEFAULT_FABLE_MODEL: persona.mind.model_list.__get__(0)?.__str__()
      ANTHROPIC_DEFAULT_OPUS_MODEL: persona.mind.model_list.__get__(1)?.__str__()
      ANTHROPIC_DEFAULT_SONNET_MODEL: persona.mind.model_list.__get__(2)?.__str__()
      ANTHROPIC_DEFAULT_HAIKU_MODEL: persona.mind.model_list.__get__(3)?.__str__()
      ANTHROPIC_CUSTOM_MODEL_OPTION: persona.mind.model_list.__get__(4)?.__str__()
      CLAUDE_CODE_SUBAGENT_MODEL: (persona.mind.model_subagent)
      CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY: "1"
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: persona.mind.context_size?.__str__()

  content: y"{config_store.__as_json__()}"

