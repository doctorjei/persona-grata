persona:
  name: "base_persona"      # Persona's name
  desc: y"{name}"           # Short Description

  mind:                     # Cognitive elements (endpoint, model, etc.)
    endpoint: None          # Connection endpoint <REQUIRED in config>
    context_size: None      # Context size (1000000, 1048576, 200000, etc.)
    model_list: []          # Models (first is default model)
    model_active: model_list.__get__(0)  # Default active model name
    model_subagent: (model_active)       # Model to use for subagents

    dialects:               # Which dialects the persona speaks
      chat<dialect.chat>: {}
      responses<dialect.responses>: {}
      anthropic<dialect.anthropic>: {}
