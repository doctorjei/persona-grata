##################################################################################################
# Minimax Persona Settings
#
# Anthropic dialect is on /anthropic, the OpenAI variants at the root.
#
# Claude's compaction-window setting for minimax lives in the agent preset, agent_minimax_claude.

persona<persona._DEFAULT_>:
  name: "minimax"
  desc: "Minimax"
  mind:
    endpoint: "https://api.minimax.io"
    dialects: {anthropic: {api_uri: y"{endpoint}/anthropic"}}

    model_list: ["MiniMax-M3.1-Flash", "MiniMax-M3", "MiniMax-M2.7-highspeed",
                 "MiniMax-M2.7", "MiniMax-M2.5-highspeed", "MiniMax-M2.5"]
    model_active: "MiniMax-M3.1-Flash"
    context_size: 1000000
