##################################################################################################
# Goose Harness Settings
#
# GOOSE_PATH_ROOT re-roots goose's whole directory tree -- config, data, state, and .agents -- so
# each persona gets its own, the same way CODEX_HOME does for the Codex CLI. Two sharp edges:
#
#   * The path MUST be absolute. Goose filters on `is_absolute()` and silently falls back to
#     ~/.config/goose if it is not, with no error. `path` resolves under `persona_store`, which
#     defaults to an absolute $XDG_CONFIG_HOME.
#   * Note the extra "config" segment: goose reads $GOOSE_PATH_ROOT/config/config.yaml.
#
# Keys are UPPERCASE in the config file, not just in the environment -- goose looks the file up by
# the same name it uses for the env var. Environment still outranks the file, so `wrapper_env` can
# override any of these per invocation.
#
# The token stays in the environment via `auth_var` rather than being written here: goose reads
# every provider secret from the environment when the primary one is set, which keeps the key out
# of both this file and the shared system keyring.
#
# Goose already verified against chat/completions by inheriting the old harness default, so
# declaring `chat` here only makes an existing fact explicit.

goose:
  harness_desc: "Goose"
  supported_dialects: ["chat"]
  protocol: y"{match_first(supported_dialects, mind.dialects)}"
  auth_var: "OPENAI_API_KEY"
  path_var: "GOOSE_PATH_ROOT"
  config_file: y"{path}/config/config.yaml"
  config_store:
    GOOSE_PROVIDER: "openai"                   # Built-in provider used for OpenAI-compatible APIs
    GOOSE_MODEL: y"{mind.model}"
    OPENAI_HOST: y"{mind.dialects[protocol].api_uri}"     # OPENAI_BASE_PATH supplies /v1/...
  content: y"{config_store.__AS_YAML__()}"
