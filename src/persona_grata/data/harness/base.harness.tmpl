##################################################################################################
# Harness Default Settings
#
# A harness declares which wire protocols it can speak, best first; the persona declares where it
# serves each one (mind.dialects). The filtered comprehension selects the name of
# the winning dialect -- which is both the compatibility answer ("no match" = cannot be built) and
# the key that locates its URIs.

harness:
  name: "base_harness"
  desc: y"{name}"                                # Harness Short Desc. (defaults to name)
  path: y"{runtime.agent_path}/harness"          # Path to custom harness settings files
  auth_var: "API_KEY"                            # Env. variable holding key/token
  path_var: ""                                   # Store var., harness config path (default: none)
  wrapper_env: {}                                # Env. vars exported by shell wrapper (conf)
  config_file: ""                                # Main harness config file (skips if empty/unset)
  config_store: {}                               # Harness config data (stored in config file)
  content: ""                                    # Content of harness config file (default: empty)
  supported_dialects: None                       # Protocols spoken, best first <REQUIRED>
  protocol: [dialect for dialect in supported_dialects if persona.mind.dialects.__get__(dialect) is not None][0]

### `supported_dialects` is REQUIRED. With the URI and the verification settings both coming from
### the negotiated dialect, a harness that declares none has no URI, nothing to verify against and
### an empty protocol -- it cannot function. The pairing is refused by name before resolution
### rather than left to fail as an unresolvable template.
