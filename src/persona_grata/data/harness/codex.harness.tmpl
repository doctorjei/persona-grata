##################################################################################################
# Codex-CLI Harness Settings
#
# This is the harness that shows why negotiation beats a single declared dialect -- codex prefers
# Responses but works over Chat, so the winning protocol depends on the persona it is bound to,
# and `wire_api` names whichever it got.

codex:
  harness_desc: "Codex CLI"
  path_var: "CODEX_HOME"
  supported_dialects: ["responses", "chat"]    # ordered by preference
  config_file: y"{path}/config.toml"
  protocol: y"{match_first(supported_dialects, mind.dialects)}"

  config_store:
    model: y"{mind.model}"
    model_provider: y"{__PARENT__.__PARENT__.__KEY__}"

    # Nested maps become TOML tables, so this renders as [model_providers.codex].
    model_providers:
      codex:
        name: y"{persona_desc}"
        wire_api: y"{protocol}"
        base_url: y"{mind.dialects[protocol].api_uri}"
        env_key: y"{auth_var}"

  content: y"{config_store.__AS_TOML__()}"

### `protocol` sits at harness level, NOT in config_store: config_store is serialized verbatim, so
### a scratch key there would emit a stray `protocol = "responses"` into the user's config.toml.
### Scope lookup still finds it from inside the nested provider table.
