##################################################################################################
# Secret Backend Built-In Settings
#
# A *secret backend* is the password manager holding an agent's API key. persona-grata runs the
# manager the user already has and reads the key from its stdout; it never encrypts anything.
# A backend is nothing more than a pair of commands, so a site can add its own.

secret:
  # Config-mutable keys (can be changed in agent_store.cfg)
  root: "agents"             # Secret key root from built-in defaults (mutable)
#  root: (runtime.defaults.secret.root) if runtime.defaults.secret.root else "agents"

  # Immutable keys (changeable only in agent documents; identity-based)
  name: None
  entry: y"{root}/{agent.name}" if root is not None else agent.name  # Store-relative entry

  fetch: ""                  # Command printing the key on STDOUT. Run at setup and by the wrapper
  store: ""                  # Command reading the key from STDIN. Run at setup only
  probe: ""                  # Executable that must exist; named in the error when it does not

### `fetch` runs at every agent launch, unattended, with no terminal to prompt at. A command that
### can block on a passphrase will hang the agent rather than fail it -- prime gpg-agent first.
