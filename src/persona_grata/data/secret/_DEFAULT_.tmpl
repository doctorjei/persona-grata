# Secret Backend Default Settings
#
# Overrides built-in defaults with agent_store.cfg defaults, where applicable.

secret<secret._BUILTIN_>:
  root: (runtime.defaults.secret.root!)  # Secret key root from config defaults
  entry: (runtime.defaults.secret.entry!)
  fetch: (runtime.defaults.secret.fetch!)
  store: (runtime.defaults.secret.store!)
  probe: (runtime.defaults.secret.probe!)
  check: (runtime.defaults.secret.check!)
