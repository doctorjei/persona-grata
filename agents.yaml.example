persona_store: "~/.alternative_config/personas"

personas:
  easy_api:
    mind:
      endpoint: "https://api.easypeasy.org"

  orion:
    persona_desc: "Orion Toolkit"

    mind:
      endpoint: "https://api.cybertron.space"
      model: "alpha-3-on"

    harnesses:
      claude:
        base_uri: "{{mind.endpoint}}/anthropic"
      codex:
        base_uri: "{{mind.endpoint}}/openai"

  pax:
    persona_desc: "Pax Toolkit"
    mind:
      endpoint: "https://api.moonbase.space"
    harnesses:
      claude:
        harness_desc: "Sneaky Claude"
        path: "~/my/secret/claude"

        verify:
          url: "{{base_uri}}/verify_me"
          key_header: "x-api-key:" # If the service only supports traditional Anthropic-style keys
