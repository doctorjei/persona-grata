persona_store: "$XDG_CONFIG_HOME/personas"
personas:
  orion:
    persona_desc: "Orion Pax Toolkit"
    path: "{{persona_store}}/{{__PARENT__.__KEY__}}"
    mind:
      endpoint: "https://api.cybertron.space"
      model: "alpha-3-on"
      token_path: "{{path}}/token"
    harnesses:
      claude:
        harness_desc: "Claude Code"
        path: "{{path}}/{{__PARENT__.__KEY__}}"
        config_file: "{{path}}/settings.json"
        auth_env: "ANTHROPIC_AUTH_TOKEN"
        config_env: "CLAUDE_CONFIG_DIR"
        template: |
          {
            "model": "sonnet",
            "env": {
              "ANTHROPIC_BASE_URL": "{{mind.endpoint}}",
              "ANTHROPIC_DEFAULT_OPUS_MODEL": "{{mind.model}}",
              "ANTHROPIC_DEFAULT_SONNET_MODEL": "{{mind.model}}",
              "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{mind.model}}"
            }
          }
        verify:                                 # optional; omitting skips check
          url: "{{mind.endpoint}}/v1/messages"
          key_header: "x-api-key:"              # runtime appends " <key>"
          headers:                              # Non-shared headers (optional)
            - "anthropic-version: 2023-06-01"
      codex:
        harness_desc: "Codex CLI"
        path: "{{path}}/{{__PARENT__.__KEY__}}"
        config_file: "{{path}}/config.toml"
        auth_env: "API_KEY"
        config_env: "CODEX_HOME"
        template: |
          model = "{{mind.model}}"
          model_provider = "{{harnesses.__PARENT__.__KEY__}}"
          [model_providers.{{harnesses.__PARENT__.__KEY__}}]
          name = "{{persona_desc}}"
          base_url = "{{mind.endpoint}}"
          wire_api = "responses"
          env_key = "{{auth_env}}"
        verify:
          url: "{{mind.endpoint}}/v1/chat/completions"
          key_header: "Authorization: Bearer"
